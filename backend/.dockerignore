# vendor/ est réinstallé dans l'image par composer install.
# Le copier depuis l'hôte fait segfaulter la génération de l'autoloader
# quand il a été installé sous un autre OS.
vendor/
node_modules/

# config locale et caches, propres à la machine
.env
.env.*
!.env.example
.phpunit.result.cache
storage/logs/*
storage/framework/cache/data/*
storage/framework/sessions/*
storage/framework/views/*

.git/
.github/
